# Copy this file to ".env" for local development. NEVER commit .env to git.

ENVIRONMENT=development

# Free key from console.groq.com
GROQ_API_KEY=

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Where the frontend runs (comma-separated if more than one)
FRONTEND_ORIGINS=http://localhost:4200

# "Continue with Google" button. Leave empty to hide it. See the main README for setup.
GOOGLE_CLIENT_ID=

# Set to false later if you want to close sign-ups
ALLOW_REGISTRATION=true

# Leave unset locally (uses backend/storage). On Render this is /data.
# DATA_DIR=/data
